{
  "name": "jxmfun-home",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "backgrounds": "node scripts/backgrounds.mjs",
    "backgrounds:gui": "node scripts/backgrounds-gui.mjs",
    "docker:up": "docker compose --env-file .env -f deploy/compose.yml up -d --build",
    "docker:recreate": "docker compose --env-file .env -f deploy/compose.yml up -d --force-recreate",
    "docker:ps": "docker compose --env-file .env -f deploy/compose.yml ps",
    "docker:logs": "docker compose --env-file .env -f deploy/compose.yml logs -f mxjweb"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "lucide-react": "^0.563.0",
    "next": "^16.4.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
